# Supabase project provisioning is a manual user step.
# Fill these in your local .env (which is gitignored). Do not commit.

ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Note: no SUPABASE_JWT_SECRET. New Supabase projects sign user tokens
# with an ES256 keypair and we verify via JWKS at runtime. See
# DECISIONS.md for context.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
