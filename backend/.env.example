# Supabase project provisioning is a manual user step.
# Fill these in your local .env (which is gitignored). Do not commit.

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Comma-separated provider chain for the OCR pipeline. The pipeline tries
# each provider in order; first one whose response validates and meets the
# confidence threshold (>=0.7) wins.
# Gemini Flash primary (10x cheaper, 2x faster); Claude Sonnet fallback when
# Gemini errors or confidence<0.7; Opus last resort. Justified in
# docs/ocr-bakeoff/2026-04-27-bakeoff-v2.md.
OCR_PROVIDER_CHAIN=gemini-2.5-flash,claude-sonnet-4-6,claude-opus-4-7
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Note: no SUPABASE_JWT_SECRET. New Supabase projects sign user tokens
# with an ES256 keypair and we verify via JWKS at runtime. See
# DECISIONS.md for context.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Browser origins allowed to call this API, comma-separated.
#
# The app and this API are never same-origin: 8081 against 8000 locally, and a
# Cloudflare Pages site against wherever this is hosted in production. Without
# a match the browser refuses every request before sending it, which shows up
# as "Failed to fetch" and names nothing.
#
# Unset covers localhost development only. A deployment must name its own
# origin — including the *.pages.dev preview domain if previews should work:
#   CORS_ALLOWED_ORIGINS=https://intempo.pages.dev,https://intempo-preview.pages.dev
CORS_ALLOWED_ORIGINS=
