# Copy to backend/.env (gitignored) for local development and fill in your own
# keys. Do not commit. Supabase project provisioning is a manual step.

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# The page reader. `homr` is the default and the only reader the owner has
# chosen to ship ("run homr only, no backup AI", 2026-08-24): the vision models
# that used to back it up were inventing notes. homr is installed only in the
# Modal container (docs/deploy-modal.md), so a local API with this setting
# refuses every scan with a message that blames the server, not the photograph.
# `app/config.py` has the full reasoning.
OCR_PROVIDER_CHAIN=homr
# Claude re-reads only the bars that do not add up, and reads tempo words and
# dynamics off the photograph. Both need ANTHROPIC_API_KEY; set either to the
# empty string to turn it off. `/v1/ready` reports which are running.
OCR_CORRECTOR=claude-sonnet-5
OCR_TEMPO_READER=claude-sonnet-5
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Note: no SUPABASE_JWT_SECRET. New Supabase projects sign user tokens
# with an ES256 keypair and we verify via JWKS at runtime. See
# DECISIONS.md for context.

# Browser origins allowed to call this API, comma-separated.
#
# The app and this API are never same-origin: 8081 against 8000 locally, and a
# Cloudflare Pages site against wherever this is hosted in production. Without
# a match the browser refuses every request before sending it, which shows up
# as "Failed to fetch" and names nothing.
#
# Unset covers localhost development only. A deployment must name its own
# origin — including the *.pages.dev preview domain if previews should work:
#   CORS_ALLOWED_ORIGINS=https://intempo.pages.dev,https://intempo-preview.pages.dev
CORS_ALLOWED_ORIGINS=
