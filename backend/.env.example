# Supabase project provisioning is a manual user step.
# Fill these in your local .env (which is gitignored). Do not commit.

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Comma-separated provider chain for the OCR pipeline. The pipeline tries
# each provider in order; first one whose response validates and meets the
# confidence threshold wins. Default mirrors the Claude-only Sonnet→Opus
# behavior from the original spec; the bake-off (see bakeoff/) determines
# whether to swap in a Gemini provider after fixtures are in.
OCR_PROVIDER_CHAIN=claude-sonnet-4-6,claude-opus-4-7
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Note: no SUPABASE_JWT_SECRET. New Supabase projects sign user tokens
# with an ES256 keypair and we verify via JWKS at runtime. See
# DECISIONS.md for context.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
