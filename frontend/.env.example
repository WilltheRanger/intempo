# Copy to .env.local and fill in. All are optional for a design/build
# preview; auth + analytics activate only when their keys are present.

# Backend API base (FastAPI). Defaults to http://127.0.0.1:8000.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Supabase (enables magic-link auth). From Project Settings → API.
# The redirect URL (http://localhost:5173/) must be allow-listed in the
# Supabase dashboard under Authentication → URL Configuration.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PostHog product analytics (optional).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
